# GoalBot cloud deployment environment.
# Copy this file to .env on the Ubuntu server, then fill real secrets.

# Local-only frontend port. FRPC reaches goalbot-frontend directly over Docker networking.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080

# MySQL. Use strong passwords in production.
MYSQL_USERNAME=goalbot
MYSQL_PASSWORD=change_me_goalbot_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# GoalBot authentication and runtime.
GOALBOT_BOOTSTRAP_ADMIN_USERNAME=local_user
GOALBOT_BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password
GOALBOT_AUTH_SESSION_DAYS=30
GOALBOT_REMINDER_ENABLED=true

# Dify chat API.
# Example if Dify runs on the same Ubuntu host outside this compose stack:
# DIFY_API_URL=http://host.docker.internal:5001/v1/chat-messages
DIFY_ENABLED=true
DIFY_API_URL=
DIFY_API_KEY=

# Dify workflow API for intent recognition.
# Example:
# DIFY_WORKFLOW_API_URL=http://host.docker.internal:5001/v1/workflows/run
DIFY_WORKFLOW_API_URL=
DIFY_WORKFLOW_API_KEY=
DIFY_TIMEOUT_SECONDS=60

# Feishu app bot.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DEFAULT_CHAT_ID=

# You currently prefer long connection mode.
FEISHU_LONG_CONNECTION_ENABLED=true

# FRP client. Use the overseas VPS public IP or a Cloudflare DNS-only hostname.
# Do not use an orange-cloud proxied hostname for the FRP control connection.
FRPC_IMAGE=snowdreamtech/frpc:latest
FRP_SERVER_ADDR=frp.example.com
FRP_SERVER_PORT=7000
FRP_REMOTE_PORT=18080
FRP_AUTH_TOKEN=replace_with_the_same_random_token_as_frps
